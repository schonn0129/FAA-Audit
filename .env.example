# FAA Audit Application - Environment Configuration
# Copy this to .env in the root directory and adjust as needed

# Backend Configuration
FLASK_ENV=production
FLASK_DEBUG=0
EMBEDDING_ENABLED=true
PYTHONUNBUFFERED=1

# Database Configuration
DATABASE_PATH=/app/data/faa_audit.db
UPLOAD_FOLDER=/app/uploads
MANUALS_FOLDER=/app/manuals

# Server Configuration
BACKEND_PORT=5000
FRONTEND_PORT=8888

# Optional: API Configuration
# API_MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
# API_TIMEOUT=300  # Seconds

# Optional: Embedding Configuration
# EMBEDDING_MODEL=all-MiniLM-L6-v2  # Sentence transformer model
# EMBEDDING_BATCH_SIZE=32
